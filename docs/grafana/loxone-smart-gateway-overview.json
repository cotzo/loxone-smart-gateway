{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus scraping the Loxone Smart Gateway /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "1.0.0" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Operational dashboard for Loxone Smart Gateway provider latency and queues, Hue grouped-light request reduction, irrigation decisions, Lawn Dry state, and persisted weather/run history. Expects Prometheus scraping /metrics with Configuration__EnablePrometheus=true.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Provider queue depth",
      "description": "Unique pending commands across Hue light, Hue grouped-light, and Tuya queues. A persistent rise suggests provider/network backpressure.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum by (provider, resource_type, bridge) (gateway_provider_queue_pending{provider=~\"$provider\", bridge=~\"$bridge\"})", "legendFormat": "{{provider}} / {{bridge}} / {{resource_type}}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Provider event â†’ dispatch latency (p50 / p95)",
      "description": "Loxone state receipt to the start of a Hue/Tuya send. Includes queue wait and pacing, but excludes provider network response time.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le, provider, resource_type, bridge) (rate({__name__=~\"gateway_provider_event_to_dispatch(_milliseconds)?_bucket\", provider=~\"$provider\", bridge=~\"$bridge\"}[5m])))", "legendFormat": "p50 {{provider}} / {{bridge}} / {{resource_type}}", "refId": "A" },
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, provider, resource_type, bridge) (rate({__name__=~\"gateway_provider_event_to_dispatch(_milliseconds)?_bucket\", provider=~\"$provider\", bridge=~\"$bridge\"}[5m])))", "legendFormat": "p95 {{provider}} / {{bridge}} / {{resource_type}}", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue wait vs provider request time (p95)",
      "description": "Separates gateway backlog/pacing from network/device time. Hue has distinct light and grouped_light series; Tuya is device-level and includes connect + send.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, provider, resource_type, bridge) (rate({__name__=~\"gateway_provider_queue_wait(_milliseconds)?_bucket\", provider=~\"$provider\", bridge=~\"$bridge\"}[5m])))", "legendFormat": "queue p95 {{provider}} / {{bridge}} / {{resource_type}}", "refId": "A" },
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, provider, resource_type, bridge) (rate({__name__=~\"gateway_provider_request_duration(_milliseconds)?_bucket\", provider=~\"$provider\", bridge=~\"$bridge\"}[5m])))", "legendFormat": "request p95 {{provider}} / {{bridge}} / {{resource_type}}", "refId": "B" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Provider command rate",
      "description": "Per-attempt outcomes: success, failure, or invalid converted input. Tuya dispatch acknowledgement is best-effort, so success means the local send path completed.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (provider, resource_type, outcome, bridge) (rate({__name__=~\"gateway_provider_commands(_total)?\", provider=~\"$provider\", bridge=~\"$bridge\"}[5m]))", "legendFormat": "{{provider}} / {{bridge}} / {{resource_type}} / {{outcome}}", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue coalescing, retries & exhausted failures",
      "description": "Coalescing is expected for repeated state updates while work is pending. Retries or exhausted failures that rise continuously warrant investigation.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "editorMode": "code", "expr": "sum by (provider, resource_type, bridge) (rate({__name__=~\"gateway_provider_commands_coalesced(_total)?\", provider=~\"$provider\", bridge=~\"$bridge\"}[5m]))", "legendFormat": "coalesced {{provider}} / {{bridge}} / {{resource_type}}", "refId": "A" },
        { "editorMode": "code", "expr": "sum by (provider, resource_type, bridge) (rate({__name__=~\"gateway_provider_command_retries(_total)?\", provider=~\"$provider\", bridge=~\"$bridge\"}[5m]))", "legendFormat": "retries {{provider}} / {{bridge}} / {{resource_type}}", "refId": "B" },
        { "editorMode": "code", "expr": "sum by (provider, resource_type, bridge) (rate({__name__=~\"gateway_provider_command_failures(_total)?\", provider=~\"$provider\", bridge=~\"$bridge\"}[5m]))", "legendFormat": "exhausted {{provider}} / {{bridge}} / {{resource_type}}", "refId": "C" }
      ]
    },
    {
      "id": 29,
      "type": "row",
      "title": "Hue grouped-light optimization",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "panels": []
    },
    {
      "id": 30,
      "type": "stat",
      "title": "Hue group optimizations",
      "description": "Number of exact-coverage grouped-light bundles routed as one larger Hue group request in the selected time range.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "editorMode": "code", "expr": "sum(increase({__name__=~\"gateway_hue_group_optimizations(_total)?\", bridge=~\"$bridge\"}[$__range]))", "legendFormat": "optimizations", "refId": "A" }]
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Requests represented",
      "description": "Individual grouped-light requests that would have been sent without the optimization, across successful bundles.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "editorMode": "code", "expr": "sum(increase({__name__=~\"gateway_hue_group_requests(_total)?\", bridge=~\"$bridge\"}[$__range]))", "legendFormat": "requests", "refId": "A" }]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Requests saved",
      "description": "Number of Hue requests avoided. A bundle of N grouped-light requests contributes N-1 saved requests.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "editorMode": "code", "expr": "sum(increase({__name__=~\"gateway_hue_group_requests_saved(_total)?\", bridge=~\"$bridge\"}[$__range]))", "legendFormat": "requests saved", "refId": "A" }]
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Request reduction",
      "description": "Percent reduction for optimized bundles, calculated as saved requests divided by represented individual requests.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "editorMode": "code", "expr": "100 * sum(increase({__name__=~\"gateway_hue_group_requests_saved(_total)?\", bridge=~\"$bridge\"}[$__range])) / clamp_min(sum(increase({__name__=~\"gateway_hue_group_requests(_total)?\", bridge=~\"$bridge\"}[$__range])), 1)", "legendFormat": "reduction", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Irrigation & weather",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Latest weather age",
      "description": "Age in seconds of the latest persisted mapped weather observation. Alert if it exceeds the expected five-minute sample interval by an appropriate margin.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 600 }, { "color": "red", "value": 1800 }] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "editorMode": "code", "expr": "{__name__=~\"irrigation_weather_latest_age(_seconds)?\"}", "legendFormat": "age", "refId": "A" }]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Stored weather observations",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "editorMode": "code", "expr": "irrigation_weather_observations_stored", "legendFormat": "observations", "refId": "A" }]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Weather history span",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "d", "decimals": 1 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "editorMode": "code", "expr": "{__name__=~\"irrigation_weather_history_span(_seconds)?\"} / 86400", "legendFormat": "days", "refId": "A" }]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Irrigation recommendation",
      "description": "1 means at least one zone has a positive recommended runtime; 0 means no current recommendation.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "bool", "mappings": [{ "options": { "0": { "text": "NO WATERING" }, "1": { "text": "WATERING NEEDED" } }, "type": "value" }], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "editorMode": "code", "expr": "{__name__=~\"irrigation_decision_required\"}", "legendFormat": "recommendation", "refId": "A" }]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Weather complete / forecast available",
      "description": "Two independent readiness signals from the latest irrigation calculation.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "bool", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [
        { "editorMode": "code", "expr": "irrigation_decision_weather_complete", "legendFormat": "weather complete", "refId": "A" },
        { "editorMode": "code", "expr": "irrigation_decision_forecast_available", "legendFormat": "forecast available", "refId": "B" }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Completed irrigation runs (selected range)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "editorMode": "code", "expr": "sum(increase(irrigation_runs_completed[$__range]))", "legendFormat": "runs", "refId": "A" }]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Weather observation interval (p50 / p95)",
      "description": "Intervals between persisted combined weather snapshots. The scheduled commit cadence is five minutes; stale values are reused when Loxone does not emit a change.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=~\"irrigation_weather_observation_interval(_seconds)?_bucket\"}[1h])))", "legendFormat": "p50 interval", "refId": "A" },
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"irrigation_weather_observation_interval(_seconds)?_bucket\"}[1h])))", "legendFormat": "p95 interval", "refId": "B" },
        { "editorMode": "code", "expr": "rate({__name__=~\"irrigation_weather_observations_committed(_total)?\"}[1h]) * 3600", "legendFormat": "observations / hour", "refId": "C", "hide": true }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Irrigation runs & applied water",
      "description": "Run count rate and distribution of estimated applied millimeters. Water applied is calculated from runtime and configured application rate, not measured flow.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "showPoints": "never" } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "water applied.*" }, "properties": [{ "id": "unit", "value": "mm" }] }, { "matcher": { "id": "byRegexp", "options": "completed runs.*" }, "properties": [{ "id": "unit", "value": "ops" }] }] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate({__name__=~\"irrigation_runs_completed(_total)?\"}[1h])) * 3600", "legendFormat": "completed runs / hour", "refId": "A" },
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"irrigation_run_duration(_seconds)?_bucket\"}[1h])))", "legendFormat": "run duration p95", "refId": "B" },
        { "editorMode": "code", "expr": "sum(rate({__name__=~\"irrigation_run_water_applied(_millimeters)?_sum\"}[1h]))", "legendFormat": "water applied (mm/hour)", "refId": "C" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Lawn Dry state & surface wetness",
      "description": "Current Lawn Dry boolean and estimated surface wetness. Freshness, rain, active lawn irrigation, and heavy-rain lockout are shown as separate series.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "showPoints": "last" } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "surface wetness.*" }, "properties": [{ "id": "unit", "value": "mm" }] }] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "editorMode": "code", "expr": "irrigation_lawn_dry_allowed", "legendFormat": "Lawn Dry allowed", "refId": "A" },
        { "editorMode": "code", "expr": "{__name__=~\"irrigation_lawn_dry_surface_wetness(_millimeters)?\"}", "legendFormat": "surface wetness (mm)", "refId": "B" },
        { "editorMode": "code", "expr": "irrigation_lawn_dry_weather_fresh", "legendFormat": "weather fresh", "refId": "C" },
        { "editorMode": "code", "expr": "irrigation_lawn_dry_raining", "legendFormat": "raining", "refId": "D" },
        { "editorMode": "code", "expr": "irrigation_lawn_dry_irrigation_running", "legendFormat": "lawn irrigation running", "refId": "E" },
        { "editorMode": "code", "expr": "irrigation_lawn_dry_heavy_rain_lockout", "legendFormat": "heavy-rain lockout", "refId": "F" }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Weather history & decision freshness",
      "description": "Retained observation count, history span, and age of the latest irrigation calculation. State gauges change when the service recalculates or processes new stored data.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "showPoints": "last" } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "history span.*" }, "properties": [{ "id": "unit", "value": "d" }] }, { "matcher": { "id": "byRegexp", "options": "age.*" }, "properties": [{ "id": "unit", "value": "s" }] }] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "editorMode": "code", "expr": "{__name__=~\"irrigation_weather_observations_stored\"}", "legendFormat": "stored samples", "refId": "A" },
        { "editorMode": "code", "expr": "{__name__=~\"irrigation_weather_history_span(_seconds)?\"} / 86400", "legendFormat": "history span (days)", "refId": "B" },
        { "editorMode": "code", "expr": "{__name__=~\"irrigation_decision_latest_age(_seconds)?\"}", "legendFormat": "decision age (seconds)", "refId": "C" }
      ]
    },
    {
      "id": 17,
      "type": "row",
      "title": "Latest persisted weather readings",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "panels": []
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Temperature",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "celsius", "decimals": 1, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [{ "editorMode": "code", "expr": "{__name__=~\"irrigation_weather_observed_temperature(_.*)?\"}", "legendFormat": "temperature", "refId": "A" }]
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Humidity",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 42 },
