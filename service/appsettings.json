{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      },
      "Using": [
        "Serilog.Sinks.Console",
        "Serilog.Sinks.File"
      ],
      "Enrich": [
        "WithClientIp"
      ]
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Api": {
    "PhilipsHueConfiguration": {
      "IP": "",
      "AccessKey": ""
    },
    "IrrigationConfiguration": {
      "Latitude": 46.77,
      "Longitude": 23.59,
      "ElevationM": 477,
      "LuxPerWattM2": 120,
      "EffectiveRainFactor": 0.8,
      "ForecastRainWeight": 1.0,
      "MinimumIrrigationMm": 2.0,
      "ForecastHours": 24,
      "MaximumTimestampSkewMinutes": 5,
      "MaximumObservationEdgeGapMinutes": 15,
      "StateFile": "data/irrigation-state.json"
    }
  },
  "Configuration": {
    "EnablePrometheus": false
  },
  "AllowedHosts": "*"
}
