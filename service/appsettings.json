{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      },
      "Using": [
        "Serilog.Sinks.Console",
        "Serilog.Sinks.File"
      ],
      "Enrich": [
        "WithClientIp"
      ]
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Configuration": {
    "EnablePrometheus": false
  },
  "AllowedHosts": "*"
}
