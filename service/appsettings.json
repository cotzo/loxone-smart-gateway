{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      },
      "Using": [
        "Serilog.Sinks.Console",
        "Serilog.Sinks.File"
      ],
      "Enrich": [
        "WithClientIp"
      ]
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Api": {
    "PhilipsHueConfiguration": {
      "IP": "",
      "AccessKey": ""
    },
    "IrrigationConfiguration": {
      "Latitude": 46.77,
      "Longitude": 23.59,
      "ElevationM": 477,
      "LuxPerWattM2": 120,
      "EffectiveRainFactor": 0.8,
      "ForecastRainWeight": 1.0,
      "MinimumIrrigationMm": 2.0,
      "ForecastHours": 24,
      "MaximumTimestampSkewMinutes": 5,
      "MaximumObservationEdgeGapMinutes": 15,
      "StateFile": "data/irrigation-state.json",
      "Zones": [
        { "Id": "V1", "Type": "Lawn", "Exposure": 0.85, "ApplicationRateMmPerHour": 10.0 },
        { "Id": "V2", "Type": "Drip", "Exposure": 0.75, "ApplicationRateMmPerHour": 24.0 },
        { "Id": "V3", "Type": "Drip", "Exposure": 0.60, "ApplicationRateMmPerHour": 24.0 },
        { "Id": "V4", "Type": "Lawn", "Exposure": 0.65, "ApplicationRateMmPerHour": 10.0 },
        { "Id": "V5", "Type": "Drip", "Exposure": 0.75, "ApplicationRateMmPerHour": 14.0 },
        { "Id": "V6", "Type": "Lawn", "Exposure": 1.00, "ApplicationRateMmPerHour": 10.0 }
      ]
    }
  },
  "Configuration": {
    "EnablePrometheus": false
  },
  "AllowedHosts": "*"
}
