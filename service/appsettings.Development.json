{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      },
      "Using": [ 
        "Serilog.Sinks.Console",
        "Serilog.Sinks.File"
      ],
      "Enrich": [
        "WithClientIp"
      ]
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Configuration": {
    "EnablePrometheus": true
  },
  "Gateway": {
    "AdminPassword": "local_test_password",
    "DataDirectory": "./data"
  }
}
